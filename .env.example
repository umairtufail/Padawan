# Copy to .env and fill in. Share real values via a password manager, not chat or git.
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
NEBIUS_VLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# dev = no login, sessions kept in memory (local UI work). supabase = real login, data in Postgres.
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=      # public key, same value as NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=      # not needed by the backend right now
SUPABASE_JWKS_URL=

# Backend CORS: comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:3000
