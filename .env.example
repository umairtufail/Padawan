# Copy to .env and fill in. Share real values via a password manager, not chat or git.
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
NEBIUS_VLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Optional: text model for the question planner and skill synthesizer (empty = the vision model). zai-org/GLM-5.3 is worth trying.
NEBIUS_TEXT_MODEL=

# dev = no login (local UI work ONLY, never deploy). admin = one hardcoded demo account, token from this backend.
# If AUTH_MODE is not set at all the backend uses admin (closed), so a forgotten setting is safe.
# supabase = real Supabase login and data in Postgres. dev and admin keep sessions in memory.
AUTH_MODE=dev
# Demo account for admin mode. Defaults: admin / admin. CHANGE both on any public deployment.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# Signs the admin tokens. Set a long random value in production (empty = random per process).
ADMIN_JWT_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=      # public key, same value as NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=      # not needed by the backend right now
SUPABASE_JWKS_URL=

# Backend CORS: comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:3000
