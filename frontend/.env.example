# Public values only. No secret keys in the frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend base URL. Frames go straight from the browser to it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to 1 to use realistic fake data with no backend (login admin/admin works).
# Leave empty for the real API.
NEXT_PUBLIC_API_MOCK=

# Which login the app shows. "admin" = the backend's demo account (default). "supabase" = real accounts in
# Supabase Auth (email + password); the backend must run with AUTH_MODE=supabase as well.
NEXT_PUBLIC_AUTH_MODE=admin
